DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_TIME_ZONE=Asia/Shanghai
DJANGO_LOG_LEVEL=INFO

DB_ENGINE=django.db.backends.mysql
DB_NAME=ai
DB_USER=root
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

REDIS_URL=redis://127.0.0.1:6379/0
REDIS_CACHE_URL=redis://127.0.0.1:6379/1
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0
CELERY_TASK_TIME_LIMIT=3600
CELERY_TASK_SOFT_TIME_LIMIT=3300

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:63342,http://localhost:5173
JWT_ACCESS_TOKEN_HOURS=1
JWT_REFRESH_TOKEN_DAYS=7

# 平台内置模型：用于攻击生成、裁判评分、防护建议，不等同于项目被评测模型。
INTERNAL_ATTACK_MODEL_NAME=moonshot-v1-8k
INTERNAL_JUDGE_MODEL_NAME=deepseek-v3
INTERNAL_RECOMMENDATION_MODEL_NAME=deepseek-v3

# 兼容旧代码的别名；新代码优先使用 INTERNAL_*。
DEFAULT_MODEL_NAME=moonshot-v1-8k
DEFAULT_EVAL_MODEL_NAME=deepseek-v3
ONE_API_BASE_URL=http://127.0.0.1:3000/v1
ONE_API_KEY=

CHROMA_BASE_URL=http://127.0.0.1:8001
CHROMA_COLLECTION_NAME=ai_evaluation_rag
CHROMA_COLLECTION_PREFIX=ai_eval_rag
CHROMA_TIMEOUT=30
RAG_FAIL_OPEN_TO_KEYWORD=true

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
OLLAMA_EMBEDDING_TIMEOUT=120
